<% content_for :title, @event.name %>

<div class="w-full max-w-lg mx-auto space-y-6">
  <div>
    <h1 class="text-3xl font-bold">
      <%= @event.name %>
    </h1>

    <p class="mt-2 text-gray-600">
      Compartilhe fotos desse momento com a gente ❤️
    </p>
  </div>

  <% if notice.present? %>
    <p role="status" class="text-green-700">
      <%= notice %>
    </p>
  <% end %>

  <% if @photo.errors.any? %>
    <div role="alert" class="text-red-700">
      <p>Não foi possível enviar as fotos:</p>

      <ul class="list-disc pl-5">
        <% @photo.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with(
        model: @photo,
        url: public_event_photos_path(@event.public_token),
        class: "space-y-4",
        data: { controller: "photo-upload", action: "submit->photo-upload#submit turbo:submit-end->photo-upload#finish turbo:before-cache@document->photo-upload#reset" }
      ) do |form| %>

    <div>
      <%= form.label :guest_name,
                     "Seu nome (opcional)",
                     class: "block mb-2" %>

      <%= form.text_field :guest_name,
                          class: "w-full border rounded px-3 py-2" %>
    </div>

    <div class="bg-gray-100 p-4 rounded">
      <%= form.label :files,
                    "Fotos",
                    class: "block mb-2" %>

      <%= form.file_field :files,
                          multiple: true,
                          accept: "image/*",
                          data: { photo_upload_target: "files", action: "change->photo-upload#select" },
                          required: true,
                          class: "block w-full" %>

      <p class="mt-2 text-sm text-gray-500">
        Máximo de 20 fotos por envio e máximo de 20 MB por foto.
        Formatos aceitos: JPEG, PNG, WebP, HEIC e HEIF.
      </p>
    </div>

    <p data-photo-upload-target="counter" role="status" aria-live="polite">0 fotos selecionadas</p>
    <p data-photo-upload-target="error" role="alert" class="text-red-700" hidden></p>
    <div data-photo-upload-target="previews" class="grid grid-cols-2 sm:grid-cols-3 gap-3"></div>

    <%= form.submit "Enviar fotos",
                    data: { photo_upload_target: "button" },
                    class: "w-full rounded bg-blue-600 text-white px-4 py-3 cursor-pointer font-medium" %>
  <% end %>
</div>
